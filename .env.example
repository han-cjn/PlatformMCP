# 飞书自建应用(见设计文档 §8)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 钉钉企业内部应用(注意:官方 dingtalk-mcp 要求此大小写;AppKey/AppSecret)
DINGTALK_Client_ID=
DINGTALK_Client_Secret=
# 机器人配置页「复制 RobotCode」;官方 MCP 发群消息的 system 参数,
# 缺它会报 "System parameter ROBOT_CODE is required"。onboard capture 会自动抓取
ROBOT_CODE=
# 按需加载模块,逗号分隔;ALL 为全量
ACTIVE_PROFILES=dingtalk-robot-send-message,dingtalk-notice,dingtalk-notable

# 腾讯文档开放平台 Token(https://docs.qq.com/open/auth/mcp.html 登录后获取)
TENCENT_DOCS_TOKEN=

# 企微智能机器人(管理后台 → 智能专区 → 智能机器人,推荐:收发一体,长连接收消息)
# 旧版单机器人直接填下面两项;多机器人在 config.json 的 wecom.bots 各自引用变量。
# 多机器人发送必须显式传 bot_name;没有默认发送机器人,也不会自动选第一项。
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 多机器人示例:配置 config.json 的 wecom.bots 引用这些变量(不必再填该项)
# WECOM_TEST_BOT_ID=
# WECOM_TEST_BOT_SECRET=

# ---- M2 事件桥 ----
# 飞书多维表格收集表(#记录 指令写入目标)
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
BITABLE_CONTENT_FIELD=内容
# 事件端点共享密钥(配置后 /events 强制校验 X-Hub-Secret;不配置则仅监听 127.0.0.1)
HUB_EVENT_SECRET=
# 企微适配器上报地址。不写本行 → 适配器回落 http://127.0.0.1:9780/events;
# 显式写 HUB_EVENT_URL=(空) → 关闭上报,六类消息帧被丢弃, hub.chats 里企微会话
# 永远停留在旧记录(2026-11-12 实测断链根因)。故本行刻意注释掉。
# HUB_EVENT_URL=http://127.0.0.1:9780/events
# 事件投递重试上限(默认 5;需在 config.json 的 wecom.env 白名单中才会透传给子进程)
# HUB_EVENT_RETRY_MAX=5

# ---- M3 推送目标群(P0-3:配置驱动;ID 可用 hub.chats 工具枚举)----
FEISHU_CHAT_ID=
DINGTALK_OPEN_CONVERSATION_ID=
WECOM_CHAT_ID=

# ---- M3 场景 B 日报(定时/时区/推送平台等在 config.json 的 report 段;此处仅需数据源凭据)----
# 依赖:BITABLE_APP_TOKEN/BITABLE_TABLE_ID(上方)+ TENCENT_DOCS_TOKEN + 至少一个推送目标群
# 手动触发:./hub -run-report [-report-date YYYY-MM-DD],或 MCP 元工具 hub.report.run
