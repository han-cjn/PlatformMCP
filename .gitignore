/hub
/bin/
*.exe

# 日志与临时文件
*.log
*.tmp
*.bak
*.swp
*~

# 本地持久化 DB
*.db
*.db-wal
*.db-shm

# macOS / Windows
.DS_Store
Thumbs.db

# IDE 配置(个人偏好,不强制统一)
.vscode/
.idea/
.cursor/

# WorkBuddy 工作区数据(会话/记忆日志,本地保留)
.workbuddy/

# 调试脚本与临时验收工具(本地保留,不入库)
debug/

